# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/test?retryWrites=true&w=majority

# Server Port
PORT=5000

# Twilio WhatsApp Integration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP=whatsapp:+919876543210

# Supplier order destination (optional — falls back to OWNER_WHATSAPP)
SUPPLIER_WHATSAPP=whatsapp:+919812345678

# Google Gemini AI
GEMINI_API_KEY=your_google_generative_ai_api_key

# Environment
NODE_ENV=development
